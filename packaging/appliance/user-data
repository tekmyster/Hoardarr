#cloud-config
autoinstall:
  version: 1
  # Installation-disk selection is always interactive. Hoardarr never guesses
  # that the largest disk is the operating-system target.
  interactive-sections:
    - identity
    - storage
  refresh-installer:
    update: false
  locale: en_US.UTF-8
  keyboard:
    layout: us
  # Identity is deliberately interactive. The installer must obtain a real
  # administrator login before it can finish; a locked placeholder account
  # would leave a newly installed appliance with no way to run `hoardarr setup`.
  ssh:
    install-server: true
    allow-pw: false
  storage:
    layout:
      name: direct
  packages:
    - python3.12
    - python3.12-venv
    - smartmontools
    - nvme-cli
    - lsscsi
    - sg3-utils
    - mergerfs
  late-commands:
    - curtin in-target --target=/target -- mkdir -p /opt/hoardarr-install
    - cp /cdrom/hoardarr/hoardarr-release.tar.gz /target/opt/hoardarr-install/release.tar.gz
    - curtin in-target --target=/target -- tar -xzf /opt/hoardarr-install/release.tar.gz -C /opt/hoardarr-install
    - curtin in-target --target=/target -- sh -c 'release="$(find /opt/hoardarr-install -mindepth 1 -maxdepth 1 -type d -name "hoardarr-*" -print -quit)"; test -n "$release"; exec bash "$release/scripts/install.sh" "$release"'
    - curtin in-target --target=/target -- systemctl enable hoardarr-api.service hoardarr-worker.service
  user-data:
    runcmd:
      - [sh, -c, 'printf "%s\n" "Run sudo hoardarr setup to create the Hoardarr owner account." "The Linux account selected during installation is only for appliance administration." >/etc/motd.d/hoardarr']
