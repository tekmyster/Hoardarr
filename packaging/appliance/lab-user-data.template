#cloud-config
# Persistent-development-lab seed only. The production appliance keeps identity and
# storage interactive. Lab provisioning verifies that exactly one virtual OS disk is
# attached before booting this image; purpose-created data VMDKs are attached later.
autoinstall:
  version: 1
  refresh-installer:
    update: false
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: hoardarr-lab
    realname: Hoardarr Lab Administrator
    username: hoardarr
    # Unknown random password hash: keeps the account valid for public-key SSH
    # while `allow-pw: false` prevents password authentication.
    password: "$6$nnRsvDDPuvhKKFg5$lDQEqnK/HoSjC2rqadCpAxOqtlwqY9KQLRvGvLbbuBHnRfJoGnVXbe1.3iGi.5vTqKGPAp3Dfh3CFDKSyi8Uz1"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - __SSH_PUBLIC_KEY__
  storage:
    layout:
      name: direct
  packages:
    - python3.12
    - python3.12-venv
    - smartmontools
    - nvme-cli
    - lsscsi
    - sg3-utils
    - mergerfs
    - open-vm-tools
  late-commands:
    - curtin in-target --target=/target -- mkdir -p /opt/hoardarr-install
    - cp /cdrom/hoardarr/hoardarr-release.tar.gz /target/opt/hoardarr-install/release.tar.gz
    - curtin in-target --target=/target -- tar -xzf /opt/hoardarr-install/release.tar.gz -C /opt/hoardarr-install
    - curtin in-target --target=/target -- sh -c 'release="$(find /opt/hoardarr-install -mindepth 1 -maxdepth 1 -type d -name "hoardarr-*" -print -quit)"; test -n "$release"; exec bash "$release/scripts/install.sh" apply --yes --preserve-existing-login-account --defer-service-start'
    - curtin in-target --target=/target -- systemctl enable hoardarr-api.service hoardarr-worker.service open-vm-tools.service
  user-data:
    users:
      - name: hoardarr
        lock_passwd: false
        groups: [adm, sudo]
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        ssh_authorized_keys:
          - __SSH_PUBLIC_KEY__
    runcmd:
      - [sh, -c, 'mkdir -p /etc/motd.d && printf "%s\n" "Persistent Hoardarr development lab. Virtual test storage only." >/etc/motd.d/hoardarr-lab']
