# Copy to /etc/hoardarr/fleet-ingestion.env with mode 0640 and replace every
# change-me value before starting the service.
HOARDARR_FLEET_DATABASE_URL=postgresql+psycopg://hoardarr_fleet:change-me@127.0.0.1:5432/hoardarr_fleet
HOARDARR_FLEET_SECRET_KEY_FILE=/var/lib/hoardarr-fleet/secret.key
HOARDARR_FLEET_ADMIN_TOKEN=change-me-with-at-least-32-random-characters
HOARDARR_FLEET_BIND_HOST=127.0.0.1
HOARDARR_FLEET_BIND_PORT=8091
