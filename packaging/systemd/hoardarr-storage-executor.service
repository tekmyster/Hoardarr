[Unit]
Description=Hoardarr privileged storage executor
Documentation=file:/usr/share/doc/hoardarr/disk-quarantine.md
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/lib/hoardarr/venv/bin/python -m hoardarr.storage.executor --socket /run/hoardarr/storage-executor.sock --detector /usr/lib/hoardarr/scripts/detect-hardware.py --quarantine-marker /var/lib/hoardarr/storage-executor/quarantine.json
RuntimeDirectory=hoardarr
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s

# This is the only process allowed to mutate storage. It has no network access,
# accepts a closed set of typed operations, and resolves /dev paths itself.
PrivateDevices=no
NoNewPrivileges=yes
# This service must create mounts in the host mount namespace. systemd's
# filesystem namespace controls (including PrivateTmp, ProtectSystem,
# ProtectHome, ReadWritePaths, ProtectClock, ProtectControlGroups and the
# ProtectKernel* path controls) explicitly prevent service-created mounts from
# propagating to the host. Keep the closed typed protocol and syscall hardening
# below instead of enabling those directives. AF_NETLINK is required by the
# targeted udev trigger used after an approved drive leaves quarantine; no IP
# networking is available to this service.
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
