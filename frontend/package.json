{
  "name": "hoardarr-web",
  "private": true,
  "version": "0.3.10",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "test": "vitest run",
    "test:a11y": "vitest run src/accessibility.test.tsx",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "axe-core": "^4.10.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
